{
  "name": "sfods-converter",
  "version": "0.0.1",
  "description": "Convert between flat ODS spreadsheets and the simplified sfods format",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "to-json": "./dist/to-json.mjs",
    "to-xml": "./dist/to-xml.mjs",
    "to-yaml": "./dist/to-yaml.mjs",
    "to-html": "./dist/to-html.mjs",
    "to-fods": "./dist/to-fods.mjs"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --import tsx --test test.mts roundtrip.test.mts",
    "all": "npm run build && npm run format && npm run lint && npm test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
